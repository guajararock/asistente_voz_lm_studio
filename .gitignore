# Docker y contenedores
# Se mantiene la configuracion del Dev Container versionada para que el proyecto
# pueda abrirse correctamente en contenedores y entornos de desarrollo.
# .devcontainer/ no se ignora para que quede disponible en Git.

docker-compose.override.yml

# Script local opcional para variables de entorno del usuario
.env.local
